{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm uninstall *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git pull *)",
      "mcp__ide__getDiagnostics",
      "Bash(echo \"=== TSC EXIT: $? ===\")",
      "Bash(awk '/^\\\\.feed-shell \\\\{/,/^\\\\}/' app/globals.css)",
      "Bash(awk '/^\\\\.feed-timeline/,/^\\\\}/' app/globals.css)",
      "Bash(awk '/\\\\.theme-bg-gradient \\\\{/,/^\\\\}/' app/globals.css)",
      "Bash(awk '/^\\\\.feed-drawer-scrim \\\\{/,/^\\\\}/' app/globals.css)",
      "Bash(awk '/^\\\\.feed-chrome \\\\{/,/^\\\\}/' app/globals.css)",
      "Bash(echo \"=== EXIT: $? ===\")",
      "Bash(git stash *)",
      "Read(//tmp/**)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "defaultMode": "acceptEdits"
  }
}
