# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by `npx expo prebuild`
/android
/ios

# Dependencies
node_modules/

# Secrets. The app reads the Paystack public key, the Supabase URL and the API
# base from EXPO_PUBLIC_* env vars (see README and .env.example), so no key or
# URL is ever committed here.
#
# `google-services.json` is deliberately NOT ignored: it is not a credential —
# it ships inside every APK — and the repository already commits it for the
# Capacitor build at `android/app/google-services.json`. Ignoring this copy
# would leave `app.json` pointing at a file a fresh clone does not have.
.env
.env.local
.env.*.local
*.keystore
!debug.keystore

# Misc
*.log
.DS_Store
/dist/
/.expo/
/bundle-check/
.expo-export-test/
