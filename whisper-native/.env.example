# Whisper — native app environment
#
# Copy this file to `.env` and fill it in, then restart the bundler with
# `npx expo start --clear`. EXPO_PUBLIC_* values are inlined at build time, so a
# running bundle does not see a change to this file.

# --- Required --------------------------------------------------------------
# The same Supabase project the web app uses. No table, policy or function in
# this app works without these two.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Google sign-in ---------------------------------------------------------
# The OAuth *web* client id. Defaults to the web app's client
# (226343458064-tq6nf31ekoos2h6r7dk4dc1o1cobaoh5…), which is the same one the
# Capacitor shell's GoogleAuth plugin used. Set this only if the project's
# OAuth client rotates.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Signup gate ------------------------------------------------------------
# The web app's lib/signupGate.ts: set to "true" to reopen new-account
# creation. Anything else keeps signups closed and the Google button routed
# through the signup screen's gate — the web's exact behaviour.
# EXPO_PUBLIC_SIGNUPS_OPEN=true

# --- Payments --------------------------------------------------------------
# Paystack public key. Without it the Coin Store renders and says so instead of
# failing on the first tap. Test keys start `pk_test_`, live keys `pk_live_`.
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# --- Server routes ---------------------------------------------------------
# The deployment hosting /api/* — the coin ledger, the Cloudinary ownership
# checks, the view-once claims and the payment verification all live there.
# Defaults to the production deployment; point it at a local `next dev` to test
# server changes against the app.
EXPO_PUBLIC_API_BASE_URL=https://whisper-anonymous.vercel.app

# Used for share links and the `emailRedirectTo` on signup. Defaults to the
# production deployment.
EXPO_PUBLIC_SITE_URL=https://whisper-anonymous.vercel.app

# --- Uploads ---------------------------------------------------------------
# Cloudinary. The signed flow needs only the cloud name (the signature comes
# from /api/cloudinary/sign); the unsigned preset is the fallback for a
# deployment that cannot sign.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=whisper_unsigned
